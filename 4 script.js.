// Клас одного завдання
class Task {
    constructor(id, text) {
        this.id = id;
        this.text = text;
        this.done = false;
    }

    // Метод змінює стан завдання на протилежний
    toggle() {
        this.done = !this.done;
    }
}

// Клас для керування списком завдань
class TodoList {
    constructor() {
        this.tasks = [];
        this.nextId = 1;
    }

    // Додавання нового завдання
    add(text) {
        const task = new Task(this.nextId, text);
        this.tasks.push(task);
        this.nextId++;
    }

    // Видалення завдання за id
    remove(id) {
        this.tasks = this.tasks.filter(task => task.id !== id);
    }

    // Отримання незавершених завдань
    getActive() {
        return this.tasks.filter(task => !task.done);
    }

    // Пошук завдання за id
    findById(id) {
        return this.tasks.find(task => task.id === id);
    }
}

// Створення списку завдань
const todoList = new TodoList();

// Отримання елементів зі сторінки
const taskInput = document.querySelector("#taskInput");
const addBtn = document.querySelector("#addBtn");
const taskList = document.querySelector("#taskList");

// Функція для відображення списку на сторінці
function renderTasks() {
    taskList.innerHTML = "";

    todoList.tasks.forEach(task => {
        const li = document.createElement("li");

        li.textContent = task.done ? `✓ ${task.text}` : task.text;
        li.dataset.id = task.id;

        if (task.done) {
            li.style.textDecoration = "line-through";
        }

        taskList.appendChild(li);
    });
}

// Обробник кнопки додавання
addBtn.addEventListener("click", function () {
    const text = taskInput.value.trim();

    if (text === "") {
        alert("Введіть текст завдання");
        return;
    }

    todoList.add(text);
    taskInput.value = "";
    renderTasks();
});

// Делегування подій для списку
taskList.addEventListener("click", function (event) {
    if (event.target.tagName === "LI") {
        const id = Number(event.target.dataset.id);
        const task = todoList.findById(id);

        if (task) {
            task.toggle();
            renderTasks();
        }
    }
});
